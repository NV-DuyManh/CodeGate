# ==============================================================================
# CODEGATE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the required values.
# See docs/CONFIGURATION.md for detailed documentation of each variable.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
# For local Docker Product Mode, the defaults in compose.codegate.yml will work.
# Uncomment only if running outside Docker or changing default passwords.
# POSTGRES_DB=codegate
# POSTGRES_USER=codegate
# POSTGRES_PASSWORD=codegate_postgres_password
# DOCKER_DATABASE_URL=postgresql+psycopg2://codegate:codegate_postgres_password@postgres:5432/codegate
# CELERY_BROKER_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Required for AI Review and Scoring features.
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional fallback provider
OPENAI_API_KEY=sk-your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH (FOR USER LOGIN)
# ------------------------------------------------------------------------------
# Required to log into the CodeGate dashboard.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# 4. GITHUB APP INTEGRATION (FOR PR WEBHOOKS)
# ------------------------------------------------------------------------------
# Required to receive webhooks and post checks back to GitHub PRs.
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_SLUG=your_github_app_slug
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# Note: The private key should be placed at secrets/github-app-key.pem
# For native execution, use the real local path. Compose defaults to its mounted file.
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-key.pem

# ------------------------------------------------------------------------------
# 5. FRONTEND & API CONFIGURATION
# ------------------------------------------------------------------------------
# Optional overrides for local development
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_CODEGATE_API_URL=http://127.0.0.1:8000/api/v1
CODEGATE_FRONTEND_URL=http://127.0.0.1:5173

# Local test execution runs arbitrary repository code on this host; opt in only
# for repositories you trust. Docker test execution needs a working daemon and
# a checkout mount visible to that daemon; see CODEGATE_TECHNICAL_HANDBOOK_VI.md.
ALLOW_LOCAL_TEST_EXECUTOR=false
